# Copy this file to .env and fill in the values from your Neon project.
# Never commit .env — it is gitignored.

# Neon Console -> your project -> Auth: the Auth URL
VITE_NEON_AUTH_URL=https://ep-xxx.neonauth.us-east-2.aws.neon.tech/neondb/auth

# Neon Console -> your project -> Data API: the API URL
VITE_NEON_DATA_API_URL=https://ep-xxx.apirest.us-east-2.aws.neon.tech/neondb/rest/v1
